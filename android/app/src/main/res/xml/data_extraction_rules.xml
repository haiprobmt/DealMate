<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Neither cloud backup nor device-to-device transfer may copy the token store or caches. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
