# ---------------------------------------------------------------------------
# DealMate configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Database (docker compose) ----------------------------------------------
POSTGRES_USER=dealmate
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=dealmate
# Only needed when running the backend outside docker compose:
# DEALMATE_DATABASE_URL=postgresql+asyncpg://dealmate:password@localhost:5432/dealmate

# --- Runtime ------------------------------------------------------------------
DEALMATE_ENV=production
DEALMATE_LOG_LEVEL=INFO
# 127.0.0.1 = reachable only from this machine (use the https profile / a reverse proxy).
# 0.0.0.0   = reachable on the LAN over plain HTTP (release APK refuses plain HTTP).
DEALMATE_API_BIND=127.0.0.1
# Public hostname for automatic HTTPS with the "https" compose profile.
DEALMATE_DOMAIN=dealmate.example.com

# --- Access -------------------------------------------------------------------
# Optional. If set, a user with this token is created at startup (handy for a single family).
# Generate with:  python3 -c "import secrets; print('dm_' + secrets.token_urlsafe(32))"
# Otherwise create users with:  docker compose exec api python -m scripts.create_user "Tên"
DEALMATE_BOOTSTRAP_TOKEN=
DEALMATE_BOOTSTRAP_USER_NAME=Gia đình
DEALMATE_RATE_LIMIT_PER_MINUTE=60

# --- Marketplaces ---------------------------------------------------------------
# true  = DEMO: all three marketplaces are served by clearly labelled MOCK data.
# false = only real connectors; anything without credentials reports "not configured".
DEALMATE_MOCK_MODE=true
DEALMATE_CONNECTOR_TIMEOUT_SECONDS=8
DEALMATE_OFFER_FRESHNESS_HOURS=24
# Shopee Affiliate Open API (https://affiliate.shopee.vn) — see docs/MARKETPLACE_INTEGRATION.md
DEALMATE_SHOPEE_AFFILIATE_APP_ID=
DEALMATE_SHOPEE_AFFILIATE_SECRET=

# --- AI (optional; without a key the app uses deterministic rules) ---------------
# Read directly by the Anthropic SDK. Lives ONLY on the server, never in the Android app.
ANTHROPIC_API_KEY=
DEALMATE_AI_ENABLED=true
DEALMATE_AI_MODEL=claude-opus-5-5
DEALMATE_AI_MATCHING_ENABLED=true

# --- Price tracking & push ---------------------------------------------------------
DEALMATE_PRICE_CHECK_INTERVAL_MINUTES=360
# Firebase Cloud Messaging (optional). Mount the service-account JSON into the containers.
DEALMATE_FCM_PROJECT_ID=
DEALMATE_FCM_SERVICE_ACCOUNT_FILE=

# --- Optional: container image overrides (e.g. a mirror if Docker Hub rate-limits) ----
# PYTHON_IMAGE=mirror.gcr.io/library/python:3.13-slim
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine
# CADDY_IMAGE=mirror.gcr.io/library/caddy:2-alpine
